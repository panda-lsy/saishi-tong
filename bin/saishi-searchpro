#!/usr/bin/env bash
# OpenClaw saishi agent tool: searchpro (see saishi_tong/agent_tools.py)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PY="$ROOT/.venv/bin/python"; [[ -x "$PY" ]] || PY=python3
cd "$ROOT"
exec "$PY" -c "import sys; from saishi_tong.agent_tools import searchpro_main; sys.exit(searchpro_main(sys.argv[1:]))" "$@"
