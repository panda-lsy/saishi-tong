# Jarvis (user unit): ~/.config/systemd/user/saishi-openclaw-worker.service
[Unit]
Description=赛事通 OpenClaw 整理 worker (pull jobs from competition.shengxia.me)
After=network-online.target openclaw-gateway.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/saishi-tong
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/saishi-tong/.venv/bin/python -m saishi_tong.openclaw_worker --once
TimeoutStartSec=6h
Nice=5
